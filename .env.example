# Copy this file to `.env` and fill in your own key — never commit the real `.env`.

# Lets the contact form send submissions straight to your inbox via
# https://web3forms.com (free, no backend/server needed):
#   1. Go to https://web3forms.com
#   2. Enter the email where you want to receive messages (jaskaranmr18@gmail.com)
#   3. They email you an access key instantly — no account/password needed
#   4. Paste it below
#
# Without this key, the contact form falls back to opening the visitor's own
# email client with the message pre-filled (works, but is a worse experience).
VITE_WEB3FORMS_KEY=
